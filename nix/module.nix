{ config, lib, pkgs, ... }:
let
  cfg = config.programs.noctalia-minimizer;
  keys = cfg.keybindings;
  chord = lib.types.strMatching "[A-Za-z0-9_]+(\\+[A-Za-z0-9_]+)*";
  bind = key: title: event:
    lib.optionalString (key != null) ''
      ${key} hotkey-overlay-title="${title}" { spawn "noctalia" "msg" "plugin" "local/minimizer:actions" "all" "${event}"; }
    '';
  bindsFile = pkgs.writeText "noctalia-minimizer-niri-binds.kdl" ''
    // Generated by the noctalia-minimizer NixOS module.
    binds {
    ${bind keys.minimize "Minimize active window" "minimize"}${bind keys.panel "Noctalia Minimize" "windows"}${bind keys.minimizeAll "Minimize all windows" "minimize-all"}${bind keys.restoreAll "Restore all windows" "restore-all"}${bind keys.restoreLast "Restore last minimized window" "restore-last"}}
  '';
  used = lib.filter (k: k != null) [ keys.minimize keys.panel keys.minimizeAll keys.restoreAll keys.restoreLast ];
in
{
  options.programs.noctalia-minimizer = {
    enable = lib.mkEnableOption "the Noctalia Minimize plugin (Niri workspace parking)";
    package = lib.mkOption {
      type = lib.types.package;
      default = pkgs.callPackage ./package.nix { };
      defaultText = lib.literalExpression "pkgs.callPackage ./package.nix { }";
      description = "The noctalia-minimizer package.";
    };
    keybindings = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = ''
          Generate /etc/noctalia-minimizer/niri-binds.kdl. Niri does not read it until you add
          `include optional=true "/etc/noctalia-minimizer/niri-binds.kdl"` to your Niri config
          (or run `noctalia-minimizer-setup apply`, which checks for conflicts first).
        '';
      };
      minimize = lib.mkOption { type = lib.types.nullOr chord; default = "Mod+M"; description = "Minimize the focused window."; };
      panel = lib.mkOption { type = lib.types.nullOr chord; default = "Mod+Shift+M"; description = "Open the minimized-windows panel."; };
      minimizeAll = lib.mkOption { type = lib.types.nullOr chord; default = null; description = "Minimize every window (no confirmation)."; };
      restoreAll = lib.mkOption { type = lib.types.nullOr chord; default = null; description = "Restore every minimized window."; };
      restoreLast = lib.mkOption { type = lib.types.nullOr chord; default = null; description = "Restore the most recently minimized window."; };
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [{
      assertion = lib.length used == lib.length (lib.unique (map lib.toLower used));
      message = "programs.noctalia-minimizer.keybindings: each action needs a distinct key chord.";
    }];
    environment.systemPackages = [ cfg.package ];
    environment.pathsToLink = [ "/share/noctalia-minimizer" ];
    environment.etc."noctalia-minimizer/niri-binds.kdl" = lib.mkIf keys.enable { source = bindsFile; };
  };
}
